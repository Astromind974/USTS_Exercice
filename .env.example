# ==========================================
# BASE DE DONNÉES (PRISMA)
# ==========================================
# Format pour PostgreSQL : postgresql://UTILISATEUR:MOT_DE_PASSE@HOST:PORT/NOM_BDD?schema=public
# Format pour SQLite : file:./dev.db
DATABASE_URL="postgresql://votre_utilisateur:votre_mot_de_passe@localhost:5432/emails_db?schema=public"

# ==========================================
# CONFIGURATION NEXT.JS
# ==========================================
# URL de base de l'application (en local)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret de sécurité (si vous utilisez NextAuth ou des tokens JWT)
NEXTAUTH_SECRET="chaine_aleatoire_securisee_pour_jwt_12345"
NEXTAUTH_URL="http://localhost:3000"

# ==========================================
# SERVICES EXTÉRIEURS & APIS (IA / N8N)
# ==========================================
# Clé API Groq (utilisée pour la génération des réponses IA)
GROQ_API_KEY="gsk_exemple_cle_api_groq_123456789abcdef"

# (Optionnel) URL du Webhook n8n si Next.js doit déclencher un workflow
N8N_WEBHOOK_URL="http://localhost:5678/webhook/votre-endpoint-webhook"