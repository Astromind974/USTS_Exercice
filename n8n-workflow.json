        "specifyBody": "json",
        "jsonBody": "={{ \n  JSON.stringify({\n    \"model\": \"openai/gpt-oss-120b\",\n    \"messages\": [\n      {\n        \"role\": \"system\",\n        \"content\": \"Tu es un assistant exécutif. Génère un résumé synthétique, structuré et professionnel en français des e-mails reçus aujourd'hui. Organise le résumé avec des puces claires : 1. Points prioritaires / Urgents, 2. Synthèse générale, 3. Actions requises si nécessaire. N'ajoute pas d'en-tête inutile.\"\n      },\n      {\n        \"role\": \"user\",\n        \"content\": $json.hasEmails \n          ? \"Voici les e-mails du jour à résumer :\\n\\n\" + $json.promptText \n          : \"Aucun e-mail n'a été reçu aujourd'hui. Indique simplement qu'il n'y a pas d'activité à signaler.\"\n      }\n    ],\n    \"temperature\": 0.3\n  })\n}}",
        "options": {}
      },
