      "parameters": {
        "jsCode": "// Fonction pour extraire l'adresse e-mail propre\nconst extractEmail = (str) => {\n  if (!str) return '';\n  const match = str.match(/<([^>]+)>/);\n  return match ? match[1] : str;\n};\n\n// Mappage de tous les e-mails vers le schéma attendu par Prisma\nconst emailsList = $input.all().map(item => {\n  const email = item.json;\n\n  // Gestion de la date (conversion Unix timestamp -> ISO string)\n  const formattedDate = email.internalDate \n    ? new Date(parseInt(email.internalDate)).toISOString() \n    : (email.date ? new Date(email.date).toISOString() : new Date().toISOString());\n\n  return {\n    id: email.id,\n    sender: extractEmail(email.From || email.sender),\n    subject: email.Subject || email.subject || '(Sans objet)',\n    content: email.snippet || email.body || email.content || '',\n    date: formattedDate\n  };\n});\n\n// Envoi d'un objet unique englobant le tableau sous la clé \"emails\"\nreturn [\n  {\n    json: {\n      emails: emailsList\n    }\n  }\n];"
      },
