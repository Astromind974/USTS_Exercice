    {
      "parameters": {
        "jsCode": "// Récupération de tous les éléments reçus du nœud HTTP Request\nconst items = $input.all();\n\nlet emails = [];\n\nif (items.length > 0 && items[0].json) {\n  // Cas A : Si la clé \"emails\" existe\n  if (Array.isArray(items[0].json.emails)) {\n    emails = items[0].json.emails;\n  } \n  // Cas B : Si n8n a séparé chaque e-mail en un élément individuel (cas de Next.js)\n  else {\n    emails = items\n      .map(item => item.json)\n      .filter(e => e && (e.sender || e.subject || e.content || e.id));\n  }\n}\n\n// S'il n'y a aucun e-mail\nif (emails.length === 0) {\n  return [{\n    json: {\n      promptText: \"Aucun e-mail reçu aujourd'hui.\",\n      hasEmails: false\n    }\n  }];\n}\n\n// Construction du texte formaté pour l'IA\nconst formattedMailsText = emails.map((mail, index) => {\n  return `--- E-mail ${index + 1} ---\nExpéditeur : ${mail.sender || mail.from || 'Inconnu'}\nObjet : ${mail.subject || 'Sans objet'}\nDate : ${mail.date || ''}\nContenu : ${mail.content || mail.snippet || ''}\n`;\n}).join('\\n');\n\nreturn [{\n  json: {\n    promptText: formattedMailsText,\n    hasEmails: true,\n    totalMails: emails.length\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        784,
        16
      ],
      "id": "71fa8361-0e99-49f9-8dd3-ba8512ef65c9",
      "name": "Code in JavaScript1"
    },
    {
      "parameters": {
        "jsCode": "const groqResponse = $input.first().json;\n\n// Extraction de la réponse texte générée par Groq\nconst summaryContent = groqResponse.choices?.[0]?.message?.content || \"Impossible de générer le résumé.\";\n\nreturn [{\n  json: {\n    summary: summaryContent,\n    createdAt: new Date().toISOString()\n  }\n}];"
      },
